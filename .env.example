# PostgreSQL connection string. Works with Neon, Render, or any PostgreSQL provider.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Generate with: openssl rand -base64 64
JWT_SECRET="replace-with-a-long-random-secret"

NEXT_PUBLIC_APP_URL="https://your-domain.com"
NODE_ENV="production"

# Google OAuth (Identity Services) — login opcional para clientes
# Crie um Client ID em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"

# Asaas (carteira de pagamentos das assinaturas)
# A API key e o ambiente também podem ser configurados em /admin/asaas (salvo no banco).
ASAAS_API_KEY="sua-api-key-do-asaas"
ASAAS_ENVIRONMENT="sandbox"
ASAAS_WALLET_ID=""
ASAAS_WEBHOOK_TOKEN=""

# Lembretes automáticos via WhatsApp (Evolution API)
# URL base da sua Evolution API, chave global e nome da instância conectada.
EVOLUTION_API_URL="https://evolution.seudominio.com"
EVOLUTION_API_KEY="sua-api-key-da-evolution"
EVOLUTION_INSTANCE="vixt-beauty"

# Segredo para proteger GET /api/cron/appointment-reminders
# Configure um Cron Job chamando a cada 1 minuto com:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET="troque-por-um-segredo-longo-e-aleatorio"
